{
  "name": "twelvelabs-js",
  "version": "0.0.1",
  "description": "Twelve Labs SDK for JavaScript/TypeScript",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "lint": "eslint src/**/*.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "docs": "typedoc",
    "docs:serve": "npm run docs && npx http-server docs/api -p 8080 -o",
    "clean": "rimraf dist docs coverage .test-status.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run test && npm run build"
  },
  "jest-html-reporters": {
    "publicPath": "./docs/test-report",
    "filename": "index.html",
    "expand": true
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.15.0",
    "@typescript-eslint/eslint-plugin": "^5.55.0",
    "@typescript-eslint/parser": "^5.55.0",
    "eslint": "^8.36.0",
    "eslint-config-prettier": "^8.7.0",
    "jest": "^29.5.0",
    "jest-html-reporters": "^3.1.4",
    "prettier": "^2.8.4",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.0.5",
    "tsup": "^6.6.3",
    "typedoc": "^0.24.8",
    "typescript": "^5.0.2"
  },
  "dependencies": {
    "axios": "^1.3.4",
    "form-data": "^4.0.0"
  }
}
